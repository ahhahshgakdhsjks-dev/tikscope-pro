# === TikScope Pro — CONTOH config API key (COPY file ini jadi .env) ===
# Cara dapat APIFY_API_TOKEN (gratis $5 credit):
# 1. Daftar di https://console.apify.com/sign-up
# 2. Buka Settings → Integrations → API tokens → Copy
# 3. Format token SELALU diawali "apify_api_" + 36 karakter, contoh:
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Actor yang dipakai (sudah dites valid Okt 2026, bisa diganti di apify.js):
# TikTok Shop search: sian.agency/tiktok-shop-scraper  (~$5 / 1000 produk)
#   PENTING: per 26 Agt 2026 actor ini TIDAK support region ID & UK (hanya US, MY, SG, PH, TH, VN).
#   Untuk riset Indonesia: pakai region MY sebagai proxy tren SEA, atau pakai actor apivault_labs/tiktok-shop-scraper (mode trending:true).
# Shopee search: zen-studio/shopee-product-scraper (support ID/MY/PH/TH/VN/SG, tercepat, ~1000 produk / 2 mnt)
TIKTOK_ACTOR=sian.agency/tiktok-shop-scraper
TIKTOK_TRENDING_ACTOR=apivault_labs/tiktok-shop-scraper
SHOPEE_ACTOR=zen-studio/shopee-product-scraper

PORT=3000
CACHE_TTL_SEC=3600
MAX_LIMIT=50

# ============ BRIGHT DATA (alternatif Apify, gratis 5.000 credits/bln, tanpa kartu kredit) ============
# Daftar: https://brightdata.com → Control Panel → API token. Format: 32-char hex ATAU brd_..., contoh:
BRIGHTDATA_API_KEY=bd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dataset ID tiap kolektor (format gd_...). Buat kolektor "TikTok Shop by keyword" & "Shopee" di dashboard,
# lalu copy dataset ID ke sini. Tanpa ini → error 'dataset_id belum diset'.
BRIGHTDATA_TIKTOK_DATASET=gd_xxxxxxxxxxxx
BRIGHTDATA_SHOPEE_DATASET=gd_xxxxxxxxxxxx

# ============ TIKTOK SHOP PARTNER (RESMI — hanya produk TOKO SENDIRI, bukan riset pasar) ============
# Daftar: https://partner.tiktokshop.com → My Apps → buat app (scope seller.product.basic) →
# otorisasi seller → ambil access_token + shop_cipher via GET /authorization/202309/shops
TIKTOK_APP_KEY=1234567890123456789
TIKTOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_SHOP_CIPHER=xxxxxxxxxxxxxxxxxxxxxxxx
# TIKTOK_API_BASE=https://open-api.tikwm.com

# ============ SHOPEE OPEN PLATFORM + AFFILIATE (RESMI — hanya toko/kampanye sendiri) ============
# Daftar seller API: https://open.shopee.com → buat app → otorisasi toko.
# Affiliate: daftar https://shopee.co.id/affiliate → kelola kampanye via AMS Open API (bukan search publik).
SHOPEE_PARTNER_ID=1234567
SHOPEE_PARTNER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPEE_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
SHOPEE_SHOP_ID=600000
# SHOPEE_API_HOST=https://partner.shopeemobile.com
